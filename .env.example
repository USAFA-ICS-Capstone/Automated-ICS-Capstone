# ---------------------------------------------------------------------------
# Copy to .env and fill in what you use. .env is git-ignored.
# Values here are only read from the environment; they are never written to
# SQLite, reports or logs, and they are NOT passed to MCP server subprocesses.
# ---------------------------------------------------------------------------

# --- OpenAI (profile: openai-primary) ---
OPENAI_API_KEY=
# Model ID for the openai-primary profile (any current model on your account).
OPENAI_MODEL=gpt-5

# --- Ollama (profiles: local-qwen, local-gpt-oss, local-dolphin) ---
OLLAMA_BASE_URL=http://localhost:11434/v1

# --- vLLM (profile: local-vllm) ---
VLLM_BASE_URL=http://localhost:8000/v1
VLLM_MODEL=Qwen/Qwen3-14B
# Only needed if vLLM was started with --api-key
VLLM_API_KEY=

# --- Docker endpoint for the MCP servers: the READ-ONLY socket proxy ---
DOCKER_AUDIT_DOCKER_HOST=tcp://127.0.0.1:2375

# --- Optional: use a different config directory ---
# DOCKER_AUDIT_CONFIG_DIR=/path/to/config
